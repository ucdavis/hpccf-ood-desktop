---
batch_connect:
  template: vnc
  extra_args: "-depth 24 -verbose +extension glx"
script:
  native:
    - "--cpus-per-task"
    - "<%= cores %>"
    - "--mem"
    - "<%= mem %>G"
    <% if gpu_num.to_i > 0 %>
    - "--gpus"
    - "<%= "#{gpu_type}:" unless gpu_type.blank? %><%= gpu_num %>"
    <% end %>
  job_environment:
    PATH: /bin:/sbin:/usr/bin:/usr/sbin:/snap/bin:/opt/puppetlabs/bin:/opt/TurboVNC/bin:/opt/VirtualGL/bin
    HOME: <%= ENV['HOME'].to_s %>
    USER: <%= ENV['USER'].to_s %>
    WEBSOCKIFY_CMD: "websockify"
    TVNC_VGL: 1
